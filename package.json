{
  "name": "pgschema-to-ts",
  "version": "0.1.0",
  "description": "Generate TypeScript interfaces directly from PostgreSQL DDL SQL files without database connections using libpg-query",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "pgschema-to-ts": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "libpg-query": "^17.7.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}